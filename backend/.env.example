# 火山引擎配置（必填）
VOLCENGINE_API_KEY=your-api-key-here
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_MODEL=your-endpoint-id-here

# 数据库配置（可选，默认使用内存 Mock 数据）
DATABASE_URL=postgresql://user:password@localhost:5432/smartprice
REDIS_URL=redis://localhost:6379/0

# 调试模式（生产环境设为 false）
DEBUG=false

# 模型 HTTP 连接池：每个后端进程共用；单位为秒，read 是分块读取空闲超时
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=60
MODEL_WRITE_TIMEOUT_SECONDS=30
MODEL_POOL_TIMEOUT_SECONDS=10
MODEL_MAX_CONNECTIONS=20
# JSON 格式/Schema 失败后的修复次数，0–2；不重试网络、超时或鉴权错误
MODEL_JSON_REPAIR_ATTEMPTS=1

# 本地会话保存在启动工作目录的 data/sessions；仅支持单后端进程／实例。
# 当前不读取 Redis/PostgreSQL 会话或偏好；不需要新增环境变量或启动外部数据库。

# 流式一轮的上下文准备＋模型读取预算，默认120秒，最大180秒；锁等待另有30秒上限。
# 不会因超时自动重放流式POST；客户端等待上限240秒。
CHAT_STREAM_TIMEOUT_SECONDS=120
