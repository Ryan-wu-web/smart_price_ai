# 火山引擎配置（真实识别／对话必填；health／固定样例知识接口无需配置）
VOLCENGINE_API_KEY=your-api-key-here
VOLCENGINE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_MODEL=your-endpoint-id-here

# 数据库配置（可选，尚未接入主链路；固定样例库不依赖它们）
DATABASE_URL=
REDIS_URL=

# 调试模式（生产环境设为 false）
DEBUG=false

# 模型 HTTP 连接池：每个后端进程共用；单位为秒，read 是分块读取空闲超时
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=60
MODEL_WRITE_TIMEOUT_SECONDS=30
MODEL_POOL_TIMEOUT_SECONDS=10
MODEL_MAX_CONNECTIONS=20
# JSON 格式/Schema 失败后的修复次数，0–2；不重试网络、超时或鉴权错误
MODEL_JSON_REPAIR_ATTEMPTS=1

# 本地会话保存在启动工作目录的 data/sessions；仅支持单后端进程／实例。
# 当前会话仍使用本地文件；偏好使用本地SQLite，不依赖Redis/PostgreSQL。

# 流式一轮的上下文准备＋模型读取预算，默认120秒，最大180秒；锁等待另有30秒上限。
# 不会因超时自动重放流式POST；客户端等待上限240秒。
CHAT_STREAM_TIMEOUT_SECONDS=120

# Phase 2A：固定样例知识库随 app/catalog/sample-products.v1.json 分发。
# 无新增配置、网络或数据库依赖；启动时加载并校验，更新文件后需重启。
# 数据损坏时 knowledge 接口返回503，其他接口继续按原配置工作。

# Phase 2B：BM25＋字符TF-IDF内存索引，无Embedding密钥、模型下载或外部向量库。
# 检索参数在 app/core/retrieval_config.py；改配置／语料需重启。
# 索引构建失败只让 knowledge/search 返回503，不影响已有目录查询。

# Phase 3A：requirements/parse 为无模型的规则解析＋客户端携带状态，无新增环境变量。
# 不读取本地聊天会话，不写长期偏好；规则词表／容量位于 app/core/requirements_config.py。

# Phase 4C：可选自定义偏好文件路径。未设置时位于backend/data/preferences.sqlite3。
# PREFERENCE_SQLITE_PATH=D:/smart_price_ai/backend/data/preferences.sqlite3
# DATABASE_URL/REDIS_URL为保留配置，当前不选择远端存储；详见docs/modules/04c-preferences-memory.md。
